                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        );
        
        const Save = ({ size = 24, className = "", ...props }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className} {...props}>
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
        );
        
        const Bookmark = ({ size = 24, className = "", ...props }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className} {...props}>
                <path d="m19 21-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
        );

        function PixelArtEditor() {
          const [image, setImage] = useState(null);
          const [pixelSize, setPixelSize] = useState(10);
          const [originalImage, setOriginalImage] = useState(null);
          const [customPalette, setCustomPalette] = useState(null);
          const [paletteColors, setPaletteColors] = useState([]);
          const [applyGrayscale, setApplyGrayscale] = useState(false);
          const [showGridLines, setShowGridLines] = useState(false);
          const [drawEdges, setDrawEdges] = useState(false);
          const [edgeThreshold, setEdgeThreshold] = useState(15);
          const [lineWidth, setLineWidth] = useState(1);
          const [removeBackground, setRemoveBackground] = useState(false);
          const [bgTolerance, setBgTolerance] = useState(30);
          const [repixelateFrames, setRepixelateFrames] = useState([]);
          const [isGeneratingGif, setIsGeneratingGif] = useState(false);
          const [savedPalettes, setSavedPalettes] = useState([]);
          const [showSavePaletteModal, setShowSavePaletteModal] = useState(false);
          const [paletteName, setPaletteName] = useState('');
          const [customFilename, setCustomFilename] = useState('pixel-art');
          const canvasRef = useRef(null);
          const fileInputRef = useRef(null);
          const paletteInputRef = useRef(null);

          // Load saved palettes from localStorage on mount
          useEffect(() => {
            const saved = localStorage.getItem('pixelArtPalettes');
            if (saved) {
              try {
                setSavedPalettes(JSON.parse(saved));
              } catch (e) {
                console.error('Error loading saved palettes:', e);
              }
            }
          }, []);

          const extractColorsFromImage = (img, maxColors = 32) => {
            const tempCanvas = document.createElement('canvas');
            const tempCtx = tempCanvas.getContext('2d');
            tempCanvas.width = img.width;
            tempCanvas.height = img.height;
            tempCtx.drawImage(img, 0, 0);
            
            const imageData = tempCtx.getImageData(0, 0, img.width, img.height);
            const data = imageData.data;
            const colorMap = new Map();
            
            for (let i = 0; i < data.length; i += 4) {
              const r = data[i];
              const g = data[i + 1];
              const b = data[i + 2];
              const a = data[i + 3];
              
              if (a < 128) continue;
              
              const colorKey = `${r},${g},${b}`;
              colorMap.set(colorKey, (colorMap.get(colorKey) || 0) + 1);
            }
            
            const sortedColors = Array.from(colorMap.entries())
              .sort((a, b) => b[1] - a[1])
              .slice(0, maxColors)
              .map(([color]) => {
                const [r, g, b] = color.split(',').map(Number);
                return { r, g, b };
              });
            
            return sortedColors;
          };

          const handlePaletteUpload = (e) => {
            const file = e.target.files[0];
            if (file) {
              const reader = new FileReader();
              reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                  setCustomPalette(img);
                  const colors = extractColorsFromImage(img);
                  setPaletteColors(colors);
                };
                img.src = event.target.result;
              };
              reader.readAsDataURL(file);
            }
          };

          const removePalette = () => {
            setCustomPalette(null);
            setPaletteColors([]);
            if (paletteInputRef.current) {
              paletteInputRef.current.value = '';
            }
          };

          const addColorToPalette = (colorHex) => {
            const r = parseInt(colorHex.slice(1, 3), 16);
            const g = parseInt(colorHex.slice(3, 5), 16);
            const b = parseInt(colorHex.slice(5, 7), 16);
            
            const exists = paletteColors.some(c => c.r === r && c.g === g && c.b === b);
            if (exists) {
              alert('This color is already in your palette!');
              return;
            }
            
            setPaletteColors([...paletteColors, { r, g, b }]);
            
            if (!customPalette) {
              setCustomPalette({ name: 'Manual Palette' });
            }
          };

          const removeColor = (indexToRemove) => {
            setPaletteColors(paletteColors.filter((_, index) => index !== indexToRemove));
          };

          const getNearestPaletteColor = (r, g, b, palette) => {
            let minDistance = Infinity;
            let nearestColor = { r, g, b };

            palette.forEach(color => {
              const distance = Math.sqrt(
                Math.pow(r - color.r, 2) + 
                Math.pow(g - color.g, 2) + 
                Math.pow(b - color.b, 2)
              );

              if (distance < minDistance) {
                minDistance = distance;
                nearestColor = color;
              }
            });

            return nearestColor;
          };

          const handleImageUpload = (e) => {
            const file = e.target.files[0];
            if (file) {
              const reader = new FileReader();
              reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                  setOriginalImage(img);
                  setImage(img);
                };
                img.src = event.target.result;
              };
              reader.readAsDataURL(file);
            }
          };

          useEffect(() => {
            if (image && canvasRef.current) {
              pixelateImage();
            }
          }, [image, pixelSize, paletteColors, applyGrayscale, showGridLines, drawEdges, edgeThreshold, lineWidth, removeBackground, bgTolerance]);

          const removeImageBackground = (data, width, height, tolerance) => {
            const visited = new Uint8Array(width * height);
            const isBackground = new Uint8Array(width * height);
            
            const cornerPixels = [
              { x: 0, y: 0 },
              { x: width - 1, y: 0 },
              { x: 0, y: height - 1 },
              { x: width - 1, y: height - 1 }
            ];
            
            let bgR = 0, bgG = 0, bgB = 0;
            cornerPixels.forEach(({x, y}) => {
              const idx = (y * width + x) * 4;
              bgR += data[idx];
              bgG += data[idx + 1];
              bgB += data[idx + 2];
            });
            bgR /= cornerPixels.length;
            bgG /= cornerPixels.length;
            bgB /= cornerPixels.length;
            
            const floodFill = (startX, startY) => {
              const stack = [{x: startX, y: startY}];
              
              while (stack.length > 0) {
                const {x, y} = stack.pop();
                
                if (x < 0 || x >= width || y < 0 || y >= height) continue;
                
                const idx = y * width + x;
                if (visited[idx]) continue;
                visited[idx] = 1;
                
                const pixelIdx = idx * 4;
                const r = data[pixelIdx];
                const g = data[pixelIdx + 1];
                const b = data[pixelIdx + 2];
                
                const distance = Math.sqrt(
                  Math.pow(r - bgR, 2) +
                  Math.pow(g - bgG, 2) +
                  Math.pow(b - bgB, 2)
                );
                
                if (distance < tolerance) {
                  isBackground[idx] = 1;
                  
                  stack.push({x: x + 1, y});
                  stack.push({x: x - 1, y});
                  stack.push({x, y: y + 1});
                  stack.push({x, y: y - 1});
                }
              }
            };
            
            cornerPixels.forEach(({x, y}) => {
              floodFill(x, y);
            });
            
            for (let i = 0; i < width * height; i++) {
              if (isBackground[i]) {
                data[i * 4 + 3] = 0;
              }
            }
            
            for (let y = 1; y < height - 1; y++) {
              for (let x = 1; x < width - 1; x++) {
                const idx = y * width + x;
                if (!isBackground[idx]) {
                  let transparentNeighbors = 0;
                  const neighbors = [
                    {dx: -1, dy: 0}, {dx: 1, dy: 0},
                    {dx: 0, dy: -1}, {dx: 0, dy: 1},
                    {dx: -1, dy: -1}, {dx: 1, dy: -1},
                    {dx: -1, dy: 1}, {dx: 1, dy: 1}
                  ];
                  
                  neighbors.forEach(({dx, dy}) => {
                    const nIdx = (y + dy) * width + (x + dx);
                    if (isBackground[nIdx]) transparentNeighbors++;
                  });
                  
                  if (transparentNeighbors > 0) {
                    const alphaIdx = idx * 4 + 3;
                    const reduction = Math.min(transparentNeighbors / 8, 0.5);
                    data[alphaIdx] = Math.round(data[alphaIdx] * (1 - reduction * 0.3));
                  }
                }
              }
            }
          };

          const detectEdges = (data, width, height, threshold) => {
            const edges = new Uint8Array(width * height);
            
            for (let y = 1; y < height - 1; y++) {
              for (let x = 1; x < width - 1; x++) {
                const idx = (y * width + x) * 4;
                
                const center = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
                
                let gx = 0, gy = 0;
                
                for (let dy = -1; dy <= 1; dy++) {
                  for (let dx = -1; dx <= 1; dx++) {
                    const i = ((y + dy) * width + (x + dx)) * 4;
                    const val = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
                    
                    const sobelX = [-1, 0, 1, -2, 0, 2, -1, 0, 1];
                    const sobelY = [-1, -2, -1, 0, 0, 0, 1, 2, 1];
                    const kernelIdx = (dy + 1) * 3 + (dx + 1);
                    
                    gx += val * sobelX[kernelIdx];
                    gy += val * sobelY[kernelIdx];
                  }
                }
                
                const magnitude = Math.sqrt(gx * gx + gy * gy);
                edges[y * width + x] = magnitude > threshold ? 1 : 0;
              }
            }
            
            return edges;
          };

          const pixelateImage = () => {
            const canvas = canvasRef.current;
            const ctx = canvas.getContext('2d');
            
            canvas.width = image.width;
            canvas.height = image.height;
            
            const tempCanvas = document.createElement('canvas');
            const tempCtx = tempCanvas.getContext('2d');
            const supersample = 2;
            
            tempCanvas.width = image.width * supersample;
            tempCanvas.height = image.height * supersample;
            
            tempCtx.imageSmoothingEnabled = true;
            tempCtx.imageSmoothingQuality = 'high';
            tempCtx.drawImage(image, 0, 0, tempCanvas.width, tempCanvas.height);
            
            const tempImageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
            const tempData = tempImageData.data;
            
            if (removeBackground) {
              removeImageBackground(tempData, tempCanvas.width, tempCanvas.height, bgTolerance);
              tempCtx.putImageData(tempImageData, 0, 0);
            }
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            const imageData = ctx.createImageData(canvas.width, canvas.height);
            const data = imageData.data;
            
            let edgeMap = null;
            if (drawEdges) {
              const edgeCanvas = document.createElement('canvas');
              const edgeCtx = edgeCanvas.getContext('2d');
              edgeCanvas.width = canvas.width;
              edgeCanvas.height = canvas.height;
              edgeCtx.drawImage(image, 0, 0);
              const edgeData = edgeCtx.getImageData(0, 0, canvas.width, canvas.height);
              edgeMap = detectEdges(edgeData.data, canvas.width, canvas.height, edgeThreshold);
            }
            
            for (let y = 0; y < canvas.height; y += pixelSize) {
              for (let x = 0; x < canvas.width; x += pixelSize) {
                const blockWidth = Math.min(pixelSize, canvas.width - x);
                const blockHeight = Math.min(pixelSize, canvas.height - y);
                
                let r = 0, g = 0, b = 0, a = 0;
                let totalWeight = 0;
                
                const centerX = x + blockWidth / 2;
                const centerY = y + blockHeight / 2;
                
                for (let by = 0; by < blockHeight; by++) {
                  for (let bx = 0; bx < blockWidth; bx++) {
                    const hx = Math.floor((x + bx) * supersample);
                    const hy = Math.floor((y + by) * supersample);
                    
                    for (let sy = 0; sy < supersample; sy++) {
                      for (let sx = 0; sx < supersample; sx++) {
                        const sampleX = Math.min(hx + sx, tempCanvas.width - 1);
                        const sampleY = Math.min(hy + sy, tempCanvas.height - 1);
                        const i = (sampleY * tempCanvas.width + sampleX) * 4;
                        
                        const dx = (x + bx) - centerX;
                        const dy = (y + by) - centerY;
                        const distance = Math.sqrt(dx * dx + dy * dy);
                        const sigma = Math.max(blockWidth, blockHeight) / 3;
                        const weight = Math.exp(-(distance * distance) / (2 * sigma * sigma));
                        
                        r += tempData[i] * weight;
                        g += tempData[i + 1] * weight;
                        b += tempData[i + 2] * weight;
                        a += tempData[i + 3] * weight;
                        totalWeight += weight;
                      }
                    }
                  }
                }
                
                if (totalWeight > 0) {
                  r = Math.round(r / totalWeight);
                  g = Math.round(g / totalWeight);
                  b = Math.round(b / totalWeight);
                  a = Math.round(a / totalWeight);
                }
                
                if (applyGrayscale) {
                  const gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
                  r = g = b = gray;
                }
                
                if (paletteColors.length > 0) {
                  const nearest = getNearestPaletteColor(r, g, b, paletteColors);
                  r = nearest.r;
                  g = nearest.g;
                  b = nearest.b;
                }
                
                for (let by = 0; by < blockHeight; by++) {
                  for (let bx = 0; bx < blockWidth; bx++) {
                    const i = ((y + by) * canvas.width + (x + bx)) * 4;
                    data[i] = r;
                    data[i + 1] = g;
                    data[i + 2] = b;
                    data[i + 3] = a;
                  }
                }
              }
            }
            
            ctx.putImageData(imageData, 0, 0);
            
            if (showGridLines) {
              ctx.strokeStyle = '#000000';
              ctx.lineWidth = 1;
              ctx.globalAlpha = 0.3;
              
              for (let x = pixelSize; x < canvas.width; x += pixelSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
              }
              
              for (let y = pixelSize; y < canvas.height; y += pixelSize) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
              }
              
              ctx.globalAlpha = 1.0;
            }
            
            if (drawEdges && edgeMap) {
              ctx.fillStyle = '#000000';
              ctx.globalAlpha = 0.8;
              
              for (let y = 0; y < canvas.height; y++) {
                for (let x = 0; x < canvas.width; x++) {
                  if (edgeMap[y * canvas.width + x]) {
                    ctx.fillRect(
                      x - Math.floor(lineWidth / 2),
                      y - Math.floor(lineWidth / 2),
                      lineWidth,
                      lineWidth
                    );
                  }
                }
              }
              
              ctx.globalAlpha = 1.0;
            }
          };

          const handleDownload = async () => {
            const canvas = canvasRef.current;
            
            try {
              // Check if File System Access API is supported
              if ('showSaveFilePicker' in window) {
                const handle = await window.showSaveFilePicker({
                  suggestedName: `${customFilename}.png`,
                  types: [{
                    description: 'PNG Image',
                    accept: { 'image/png': ['.png'] }
                  }]
                });
                
                const writable = await handle.createWritable();
                const blob = await new Promise(resolve => canvas.toBlob(resolve));
                await writable.write(blob);
                await writable.close();
              } else {
                // Fallback for browsers without File System Access API
                const link = document.createElement('a');
                link.download = `${customFilename}.png`;
                link.href = canvas.toDataURL();
                link.click();
              }
            } catch (error) {
              // User cancelled or error occurred
              if (error.name !== 'AbortError') {
                console.error('Download error:', error);
              }
            }
          };

          const generateRepixelateGif = async () => {
            if (!image) {
              alert('Please upload an image first!');
              return;
            }
            
            setIsGeneratingGif(true);
            const frames = [];
            const numFrames = 3;
            
            try {
              for (let i = 0; i < numFrames; i++) {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                canvas.width = image.width;
                canvas.height = image.height;
                
                const offsetX = Math.floor((i / numFrames) * pixelSize);
                const offsetY = Math.floor((i / numFrames) * pixelSize * 0.7);
                
                const tempCanvas = document.createElement('canvas');
                const tempCtx = tempCanvas.getContext('2d');
                const supersample = 2;
                
                tempCanvas.width = image.width * supersample;
                tempCanvas.height = image.height * supersample;
                
                tempCtx.imageSmoothingEnabled = true;
                tempCtx.imageSmoothingQuality = 'high';
                tempCtx.drawImage(image, 0, 0, tempCanvas.width, tempCanvas.height);
                
                const tempImageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
                const tempData = tempImageData.data;
                
                if (removeBackground) {
                  removeImageBackground(tempData, tempCanvas.width, tempCanvas.height, bgTolerance);
                  tempCtx.putImageData(tempImageData, 0, 0);
                }
                
                const imageData = ctx.createImageData(canvas.width, canvas.height);
                const data = imageData.data;
                
                for (let y = 0; y < canvas.height; y += pixelSize) {
                  for (let x = 0; x < canvas.width; x += pixelSize) {
                    const blockWidth = Math.min(pixelSize, canvas.width - x);
                    const blockHeight = Math.min(pixelSize, canvas.height - y);
                    
                    let r = 0, g = 0, b = 0, a = 0;
                    let totalWeight = 0;
                    
                    const centerX = x + blockWidth / 2 + offsetX;
                    const centerY = y + blockHeight / 2 + offsetY;
                    
                    for (let by = 0; by < blockHeight; by++) {
                      for (let bx = 0; bx < blockWidth; bx++) {
                        const hx = Math.floor((x + bx + offsetX) * supersample) % tempCanvas.width;
                        const hy = Math.floor((y + by + offsetY) * supersample) % tempCanvas.height;
                        
                        for (let sy = 0; sy < supersample; sy++) {
                          for (let sx = 0; sx < supersample; sx++) {
                            const sampleX = Math.min(Math.max(0, hx + sx), tempCanvas.width - 1);
                            const sampleY = Math.min(Math.max(0, hy + sy), tempCanvas.height - 1);
                            const idx = (sampleY * tempCanvas.width + sampleX) * 4;
                            
                            const dx = (x + bx) - centerX;
                            const dy = (y + by) - centerY;
                            const distance = Math.sqrt(dx * dx + dy * dy);
                            const sigma = Math.max(blockWidth, blockHeight) / 3;
                            const weight = Math.exp(-(distance * distance) / (2 * sigma * sigma));
                            
                            r += tempData[idx] * weight;
                            g += tempData[idx + 1] * weight;
                            b += tempData[idx + 2] * weight;
                            a += tempData[idx + 3] * weight;
                            totalWeight += weight;
                          }
                        }
                      }
                    }
                    
                    if (totalWeight > 0) {
                      r = Math.round(r / totalWeight);
                      g = Math.round(g / totalWeight);
                      b = Math.round(b / totalWeight);
                      a = Math.round(a / totalWeight);
                    }
                    
                    if (applyGrayscale) {
                      const gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
                      r = g = b = gray;
                    }
                    
                    if (paletteColors.length > 0) {
                      const nearest = getNearestPaletteColor(r, g, b, paletteColors);
                      r = nearest.r;
                      g = nearest.g;
                      b = nearest.b;
                    }
                    
                    for (let by = 0; by < blockHeight; by++) {
                      for (let bx = 0; bx < blockWidth; bx++) {
                        const idx = ((y + by) * canvas.width + (x + bx)) * 4;
                        data[idx] = r;
                        data[idx + 1] = g;
                        data[idx + 2] = b;
                        data[idx + 3] = a;
                      }
                    }
                  }
                }
                
                ctx.putImageData(imageData, 0, 0);
                frames.push({
                  data: canvas.toDataURL(),
                  timestamp: Date.now()
                });
                
                await new Promise(resolve => setTimeout(resolve, 50));
              }
              
              setRepixelateFrames(frames);
              console.log(`Generated ${frames.length} frames successfully!`);
              
            } catch (error) {
              console.error('Error generating frames:', error);
              alert('Error generating frames. Please try again.');
