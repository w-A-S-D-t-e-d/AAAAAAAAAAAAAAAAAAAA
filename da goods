                quality: 10,
                workerScript: 'https://cdn.jsdelivr.net/npm/gif.js@0.2.0/dist/gif.worker.js'
              });

              // Load each frame as an image and add to GIF
              for (let i = 0; i < repixelateFrames.length; i++) {
