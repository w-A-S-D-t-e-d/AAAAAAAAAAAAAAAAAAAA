                                  type="number"
                                  value={lineWidth}
                                  onChange={(e) => setLineWidth(Math.max(1, parseInt(e.target.value) || 1))}
                                  className="w-16 px-2 py-1 border border-gray-300 rounded text-center"
                                />
                                <button
                                  onClick={() => setLineWidth(lineWidth + 1)}
                                  className="px-3 py-1 bg-gray-600 text-white rounded hover:bg-gray-700"
                                >
                                  +
                                </button>
                              </div>
                            </div>

                            <div className="space-y-2">
                              <div className="flex items-center justify-between">
                                <label className="text-sm text-gray-700 font-medium">
                                  Edge Threshold: {edgeThreshold}
                                </label>
                              </div>
                              <input
                                type="range"
                                min="1"
                                max="99"
                                value={edgeThreshold}
                                onChange={(e) => setEdgeThreshold(Number(e.target.value))}
                                className="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-purple-600"
                              />
                              <div className="flex justify-between text-xs text-gray-500">
                                <span>Fewer Edges</span>
                                <span>More Edges</span>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>

                      <div className="border-2 border-gray-200 rounded-lg overflow-hidden bg-gray-50 flex items-center justify-center p-4">
                        <canvas
                          ref={canvasRef}
                          className="max-w-full h-auto shadow-lg"
                          style={{ imageRendering: 'pixelated' }}
                        />
                      </div>

                      <div className="grid grid-cols-3 gap-4 text-center text-sm">
                        <div className="bg-purple-50 p-3 rounded-lg">
                          <div className="font-semibold text-purple-900">Width</div>
                          <div className="text-purple-700">{image.width}px</div>
                        </div>
                        <div className="bg-purple-50 p-3 rounded-lg">
                          <div className="font-semibold text-purple-900">Height</div>
                          <div className="text-purple-700">{image.height}px</div>
                        </div>
                        <div className="bg-purple-50 p-3 rounded-lg">
                          <div className="font-semibold text-purple-900">Blocks</div>
                          <div className="text-purple-700">
                            {Math.ceil(image.width / pixelSize)} × {Math.ceil(image.height / pixelSize)}
                          </div>
                        </div>
                      </div>

                      {repixelateFrames.length > 0 && (
                        <div className="border-t border-gray-200 pt-4 space-y-3">
                          <div className="flex items-center justify-between">
                            <h3 className="text-lg font-semibold text-gray-800">
                              Generated Frames ({repixelateFrames.length})
                            </h3>
                            <div className="flex gap-2">
                              <button
                                onClick={clearAllFrames}
                                className="px-3 py-1.5 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors text-sm"
                              >
                                Clear All
                              </button>
                              <button
                                onClick={downloadAllFrames}
                                className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm"
                              >
                                Download All Frames
                              </button>
                              <button
                                onClick={downloadAsGif}
                                disabled={isGeneratingGif}
                                className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors text-sm disabled:bg-gray-400 disabled:cursor-not-allowed"
                              >
                                {isGeneratingGif ? 'Creating GIF...' : 'Download as GIF'}
                              </button>
                            </div>
                          </div>
                          <div className="grid grid-cols-4 gap-3">
                            {repixelateFrames.map((frame, i) => (
                              <div key={`frame-${i}-${frame.timestamp}`} className="relative group">
                                <img
                                  src={frame.data || frame}
                                  alt={`Frame ${i + 1}`}
                                  className="w-full h-auto border-2 border-gray-300 rounded-lg shadow-sm hover:border-purple-500 transition-all"
                                  style={{ imageRendering: 'pixelated' }}
                                />
                                <div className="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-70 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all rounded-lg gap-2">
                                  <button
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      downloadFrame(i);
                                    }}
                                    className="p-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
                                    title="Download this frame"
                                  >
                                    <Download size={20} />
                                  </button>
                                  <button
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      console.log('Regenerate button clicked for frame', i);
                                      regenerateFrame(i);
                                    }}
                                    className="p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                                    title="Regenerate with current settings"
                                  >
                                    <RotateCw size={20} />
                                  </button>
                                </div>
                                <div className="text-center text-xs text-gray-600 mt-1">
                                  Frame {i + 1}
                                </div>
                              </div>
                            ))}
                          </div>
                          <p className="text-sm text-gray-600 bg-blue-50 p-3 rounded-lg">
                            <strong>Tip:</strong> Adjust settings (palette, pixel size, effects) and click the regenerate button on any frame to update it with new settings. Use an online GIF maker (like ezgif.com) to combine frames. Set delay to 150-200ms for best results.
                          </p>
                        </div>
                      )}
                    </div>
                  )}
                </div>

                <div className="mt-8 text-center text-gray-600 text-sm">
                  <p>Create retro-style pixel art from any image • Adjust pixel size in real-time</p>
                </div>
              </div>

              {showSavePaletteModal && (
                <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
                  <div className="bg-white rounded-2xl shadow-2xl p-6 max-w-md w-full">
                    <h3 className="text-xl font-bold text-gray-800 mb-4">Save Color Palette</h3>
                    <div className="space-y-4">
                      <div>
                        <label className="block text-sm font-medium text-gray-700 mb-2">
                          Palette Name
                        </label>
                        <input
                          type="text"
                          value={paletteName}
                          onChange={(e) => setPaletteName(e.target.value)}
                          placeholder="e.g., Sunset Colors, Retro Game"
                          className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
                          onKeyPress={(e) => e.key === 'Enter' && savePalette()}
                        />
                      </div>
                      <div>
                        <div className="text-sm text-gray-600 mb-2">
                          Colors in this palette ({paletteColors.length}):
                        </div>
                        <div className="flex flex-wrap gap-2">
                          {paletteColors.map((color, i) => (
                            <div
                              key={i}
                              className="w-8 h-8 rounded border-2 border-gray-300"
                              style={{ backgroundColor: `rgb(${color.r}, ${color.g}, ${color.b})` }}
                            />
                          ))}
                        </div>
                      </div>
                      <div className="flex gap-2 pt-2">
                        <button
                          onClick={savePalette}
                          className="flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
                        >
                          Save Palette
                        </button>
                        <button
                          onClick={() => {
                            setShowSavePaletteModal(false);
                            setPaletteName('');
                          }}
                          className="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors font-medium"
                        >
                          Cancel
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          );
        }

        ReactDOM.render(<PixelArtEditor />, document.getElementById('root'));
    </script>
</body>
</html>
