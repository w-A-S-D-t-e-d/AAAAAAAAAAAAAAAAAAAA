          const regenerateFrame = async (frameIndex) => {
            console.log('Regenerating frame:', frameIndex);
            if (!image) {
              console.error('No image available');
              return;
            }
            
            const numFrames = repixelateFrames.length;
            const i = frameIndex;
            
            try {
              console.log('Starting regeneration for frame', i);
              const canvas = document.createElement('canvas');
              const ctx = canvas.getContext('2d');
              canvas.width = image.width;
              canvas.height = image.height;
              
              const offsetX = Math.floor((i / numFrames) * pixelSize);
              const offsetY = Math.floor((i / numFrames) * pixelSize * 0.7);
              
              const tempCanvas = document.createElement('canvas');
              const tempCtx = tempCanvas.getContext('2d');
              const supersample = 2;
              
              tempCanvas.width = image.width * supersample;
              tempCanvas.height = image.height * supersample;
              
              tempCtx.imageSmoothingEnabled = true;
              tempCtx.imageSmoothingQuality = 'high';
              tempCtx.drawImage(image, 0, 0, tempCanvas.width, tempCanvas.height);
              
              const tempImageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
              const tempData = tempImageData.data;
              
              if (removeBackground) {
                removeImageBackground(tempData, tempCanvas.width, tempCanvas.height, bgTolerance);
                tempCtx.putImageData(tempImageData, 0, 0);
              }
              
              const imageData = ctx.createImageData(canvas.width, canvas.height);
              const data = imageData.data;
              
              for (let y = 0; y < canvas.height; y += pixelSize) {
                for (let x = 0; x < canvas.width; x += pixelSize) {
                  const blockWidth = Math.min(pixelSize, canvas.width - x);
                  const blockHeight = Math.min(pixelSize, canvas.height - y);
                  
                  let r = 0, g = 0, b = 0, a = 0;
                  let totalWeight = 0;
                  
                  const centerX = x + blockWidth / 2 + offsetX;
                  const centerY = y + blockHeight / 2 + offsetY;
                  
                  for (let by = 0; by < blockHeight; by++) {
                    for (let bx = 0; bx < blockWidth; bx++) {
                      const hx = Math.floor((x + bx + offsetX) * supersample) % tempCanvas.width;
                      const hy = Math.floor((y + by + offsetY) * supersample) % tempCanvas.height;
                      
                      for (let sy = 0; sy < supersample; sy++) {
                        for (let sx = 0; sx < supersample; sx++) {
                          const sampleX = Math.min(Math.max(0, hx + sx), tempCanvas.width - 1);
                          const sampleY = Math.min(Math.max(0, hy + sy), tempCanvas.height - 1);
                          const idx = (sampleY * tempCanvas.width + sampleX) * 4;
                          
                          const dx = (x + bx) - centerX;
                          const dy = (y + by) - centerY;
                          const distance = Math.sqrt(dx * dx + dy * dy);
                          const sigma = Math.max(blockWidth, blockHeight) / 3;
                          const weight = Math.exp(-(distance * distance) / (2 * sigma * sigma));
                          
                          r += tempData[idx] * weight;
                          g += tempData[idx + 1] * weight;
                          b += tempData[idx + 2] * weight;
                          a += tempData[idx + 3] * weight;
                          totalWeight += weight;
                        }
                      }
                    }
                  }
                  
                  if (totalWeight > 0) {
                    r = Math.round(r / totalWeight);
                    g = Math.round(g / totalWeight);
                    b = Math.round(b / totalWeight);
                    a = Math.round(a / totalWeight);
                  }
                  
                  if (applyGrayscale) {
                    const gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
                    r = g = b = gray;
                  }
                  
                  if (paletteColors.length > 0) {
                    const nearest = getNearestPaletteColor(r, g, b, paletteColors);
                    r = nearest.r;
                    g = nearest.g;
                    b = nearest.b;
                  }
                  
                  for (let by = 0; by < blockHeight; by++) {
                    for (let bx = 0; bx < blockWidth; bx++) {
                      const idx = ((y + by) * canvas.width + (x + bx)) * 4;
                      data[idx] = r;
                      data[idx + 1] = g;
                      data[idx + 2] = b;
                      data[idx + 3] = a;
                    }
                  }
                }
              }
              
              ctx.putImageData(imageData, 0, 0);
              const newFrame = canvas.toDataURL();
              
              setRepixelateFrames(prevFrames => {
                const updatedFrames = [...prevFrames];
                updatedFrames[frameIndex] = {
                  data: newFrame,
                  timestamp: Date.now()
                };
                return updatedFrames;
              });
              
              console.log('Frame regenerated successfully! Updated frame', frameIndex);
              
